# InfluxDB v1 settings
INFLUX_DB=hosts_metrics
INFLUX_USER=admin
INFLUX_PASS=change_me
INFLUX_HTTP_AUTH_ENABLED=true
INFLUX_PORT=8086
INFLUX_MEASUREMENT=availability_test

# Agent behavior
INTERVAL_SECONDS=5
PING_COUNT=1
PING_TIMEOUT_SECONDS=2
PING_RETRIES=3
INFLUX_READY_MAX_ATTEMPTS=30
INFLUX_READY_DELAY_SECONDS=2

# Grafana settings
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
